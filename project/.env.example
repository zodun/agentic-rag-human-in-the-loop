# --- LLM provider (anthropic | ollama | openai) ---
# "anthropic" is the default and needs ANTHROPIC_API_KEY below.
# "ollama" runs fully local and needs no key (uses LLM_MODEL in config.py).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-5        # set to claude-sonnet-5 or claude-haiku-4-5 to cut cost
# OPENAI_API_KEY=sk-...
# DRAFTER_MODEL=                        # model for the reply-drafting agent; blank = same as main

# --- Human-in-the-loop outbound reply ---
# When true, a second agent drafts a customer reply after research and the graph
# pauses for your approval before anything is written to outbox/.
HITL_REPLY_ENABLED=true

# A reviewer agent checks each draft against the researched answer before you see
# it (unsupported claims, missing caveats, tone). One automatic revision.
CRITIC_ENABLED=true

# Let the assistant fall back to a web search when your files don't cover a
# question (e.g. salary benchmarks). Web-derived parts are labelled as estimates.
WEB_SEARCH_ENABLED=false

# Optional: also POST approved replies to a Slack Incoming Webhook (still only
# after you approve). Leave blank to write to outbox/ only.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Langfuse Observability (optional) ---
# Set LANGFUSE_ENABLED=true and provide your API keys to enable tracing.
# Get your keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
